# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Virtual environments
venv/
.venv/
env/

# macOS
.DS_Store

# Excel lock / temp files (created while a workbook is open in Excel)
~$*.xlsx

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
#
# data/input/ holds the source workbooks.  They are committed because they are
# the sample dataset the tests and the CI run against, and they contain no
# credentials.  Replace them with your own workbooks locally, but keep the
# directory structure.
#
# data/output/ holds what a run produces.  The reconciled workbook and the
# approval ledger are committed for this repository only because they carry
# no real customer data - the sample data is synthetic - and because keeping
# them lets a reviewer diff the result of two runs.
#
# If you replace the sample data with real workbooks, remove the two lines
# below so no customer name, invoice number or bank transaction ID ever
# reaches version control.
#
# data/output/AI_Exception_Approvals.xlsx
# data/output/Open_AR_Detail_Reconciled_Result.xlsx

# Local overrides that may hold credentials or paths.
.env
.env.local
*.local.toml

# Scratch workbooks written outside data/output/.
AI_Exception_Approvals*.xlsx
Open_AR_Detail_Reconciled_Result *.xlsx
