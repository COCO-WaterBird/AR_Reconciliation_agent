# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/

# Virtual environments
venv/
.venv/
env/

# macOS
.DS_Store

# Excel lock / temp files (created while a workbook is open in Excel)
~$*.xlsx

# ---------------------------------------------------------------------------
# Data
# ---------------------------------------------------------------------------
#
# data/input/ holds the source workbooks.  They are committed because they are
# the sample dataset the tests and the CI run against, and they contain no
# credentials.  Replace them with your own workbooks locally, but keep the
# directory structure.
#
# data/output/ holds what a run produces.  The reconciled workbook is
# committed as a sample report, so the repository shows what the agent
# produces.  It is safe only because the sample data is synthetic.
#
# If you replace the sample data with real workbooks, delete the
# "!data/output/Open_AR_Detail_Reconciled_Result.xlsx" line below so no
# customer name, invoice number or bank transaction ID reaches version
# control.  Every other file a run writes here (scratch copies, FAILED
# diagnostics) stays ignored.
data/output/*
!data/output/.gitkeep
!data/output/Open_AR_Detail_Reconciled_Result.xlsx

# Local overrides that may hold credentials or paths.
.env
.env.local
*.local.toml

# Scratch workbooks written outside data/output/.
Open_AR_Detail_Reconciled_Result *.xlsx

# Uploaded supporting documents (contracts, emails, remittance advice) and
# their manifest.  These can hold confidential customer data and must never
# reach version control.  Synthetic demo documents live in
# data/sample/evidence/ instead.
data/evidence/
