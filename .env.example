# Local environment for the AI exception agent.
#
# Copy this file to `.env` and fill in your own values:
#
#     cp .env.example .env
#
# `.env` is listed in `.gitignore` and is never committed, so your key stays
# out of version control.  A key already present in your shell environment
# wins over the value here, so you can still override it per command:
#
#     OPENAI_API_KEY=sk-... python scripts/run_openai.py
#
# Every entry below is optional.  With no `.env` at all the project still
# runs: the deterministic rules backend needs no key, and the LLM backend
# falls back to the OPENAI_API_KEY in your environment.

# --- OpenAI ----------------------------------------------------------------

# Your key.  Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-replace-me

# The model to use for exception analysis.  gpt-4o-mini is the cheap default
# and is enough for this extraction task.
AR_AGENT_MODEL=gpt-4o-mini

# --- Local models ----------------------------------------------------------

# Point the agent at a local OpenAI-compatible server instead of the hosted
# API.  Uncomment to use Ollama or LM Studio.
# OPENAI_BASE_URL=http://localhost:11434/v1

# --- Overrides -------------------------------------------------------------

# Override the source and output workbooks for a local run.
# AR_FILE=/path/to/Open_AR_Detail.xlsx
# RESULT_FILE=/path/to/Open_AR_Detail_Reconciled_Result.xlsx
